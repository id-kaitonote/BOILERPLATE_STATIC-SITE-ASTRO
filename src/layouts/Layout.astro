---
import BaseHeader from '../components/BaseHeader.astro'
import BaseFooter from '../components/BaseFooter.astro'

const meta = {
  title: 'TITLE',
  description: 'DESCRIPTION',
  siteurl: import.meta.env.SITE,
  favicon: 'favicon.svg',
  ogp: 'ogp.jpg',
  color: '#ffffff',
}
---

<!doctype html>
<html lang="ja">
  <head>
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, maximum-scale=1.0, user-scalable=no"
    />
    <title>{meta.title}</title>
    <meta name="description" content=`${ meta.description }` />
    <meta property="og:description" content=`${ meta.description }` />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:title" content=`${ meta.title }` />
    <meta property="og:type" content="website" />
    <meta property="og:url" content=`${meta.siteurl}` />
    <meta property="og:site_name" content=`${ meta.title }` />
    <meta property="og:image" content=`${meta.siteurl}/${meta.ogp}` />
    <meta
      property="og:image:secure_url"
      content=`${meta.siteurl}/${meta.ogp}`
    />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="620" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:description" content=`${ meta.description }` />
    <meta name="twitter:title" content=`${ meta.title }` />
    <meta name="twitter:image" content=`${meta.siteurl}/${meta.ogp}` />
    <link rel="canonical" href=`${meta.siteurl}` />
    <link
      rel="icon"
      type="image/x-icon"
      href=`${meta.siteurl}/${meta.favicon}`
    />
    <link
      rel="shortcut icon"
      type="image/x-icon"
      href=`${meta.siteurl}/${meta.favicon}`
    />
    <link rel="apple-touch-icon" href=`${meta.siteurl}/${meta.favicon}` />
    <meta name="msapplication-TileColor" content=`${meta.color}` />
    <meta name="theme-color" content=`${meta.color}` />
    <meta name="author" content="© 2024 Kaito Note" />
    <meta name="format-detection" content="telephone=no,email=no,address=no" />

    <meta name="robots" content="noindex,nofollow" />
  </head>
  <body>
    <div class="transition-fade" id="swup">
      <BaseHeader />
      <main>
        <slot />
      </main>
      <BaseFooter />
    </div>
  </body>
</html>
